# Claude API (Skriptgenerierung) - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Text-zu-Sprache: edge-tts (kostenlos, kein API-Key). Stimme optional aendern,
# Liste: .venv/Scripts/edge-tts --list-voices
EDGE_TTS_VOICE=de-DE-KillianNeural

# Pexels (kostenlose Stock-Videos) - https://www.pexels.com/api/
PEXELS_API_KEY=
